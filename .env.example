NODE_ENV=development|production|test
# trace | debug | info | warn | error | fatal | silent (default: info)
LOG_LEVEL=debug
HOST=127.0.0.1
PORT=3000
TEAM_DOMAIN=https://your-team-domain.com
POLICY_AUD=your-policy-audience
ALLOWED_HOSTS=<your-allowed-hosts>,localhost,127.0.0.1
VAULT_DIR=<your-vault-directory>
RESTRICTED_NOTES_JSON=<PATH>
CAN_READ_RESTRICTED_NOTES=<your-admin-email>,<second-admin-email>
