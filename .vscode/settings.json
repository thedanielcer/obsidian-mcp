{
  "js/ts.suggest.enabled": true,
  "js/ts.suggest.autoImports": true,
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "[typescript]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": true
  },
  "vitest.nodeEnv": {
    "TEST_LOG_LEVEL": "debug"
  }
}
