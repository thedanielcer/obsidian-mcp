{
  "name": "obsidian_mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server to allow ChatGPT to read, write, and modify notes from my Obsidian vault",
  "author": "thedanielcer",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
